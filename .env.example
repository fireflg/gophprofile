APP_ENV=development
LOG_LEVEL=info

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

POSTGRES_DSN=postgres://avatars:avatars@localhost:5432/avatars?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

STORAGE_BACKEND=memory
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9000/avatars

PUBLISHER_BACKEND=noop
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=avatars.events
KAFKA_GROUP_ID=avatars-worker
KAFKA_CLIENT_ID=avatars-service

MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
THUMBNAIL_SIZES=100x100,300x300
