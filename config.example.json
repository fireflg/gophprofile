{
  "app": {
    "env": "development",
    "log_level": "info"
  },
  "http": {
    "host": "0.0.0.0",
    "port": 8080,
    "read_timeout": "30s",
    "write_timeout": "60s",
    "shutdown_timeout": "15s"
  },
  "postgres": {
    "dsn": "postgres://postgres:postgres@localhost:5432/avatars?sslmode=disable",
    "max_conns": 10,
    "min_conns": 2,
    "max_conn_lifetime": "1h"
  },
  "s3": {
    "endpoint": "localhost:9000",
    "access_key": "access_key",
    "secret_key": "secret_key",
    "bucket": "avatars",
    "region": "us-east-1",
    "use_ssl": false,
    "public_base_url": ""
  },
  "kafka": {
    "brokers": ["localhost:9092"],
    "topic": "avatars.events",
    "group_id": "avatars-worker",
    "client_id": "avatars-service",
    "write_timeout": "5s"
  },
  "image": {
    "max_file_size": 10485760,
    "allowed_mime_types": ["image/jpeg", "image/png", "image/webp"],
    "thumbnail_sizes": ["100x100", "300x300"]
  }
}
